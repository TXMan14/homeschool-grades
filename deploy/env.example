# Settings for Home School Grades (read by systemd and hsg-manage).
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=__SECRET__
# Comma-separated names/IPs you use to reach the app. Add any new one here,
# then: systemctl restart homeschool-grades
DJANGO_ALLOWED_HOSTS=__HOSTS__
# If you put this behind HTTPS (e.g. a reverse proxy), list the full origin:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://grades.example.com
# DJANGO_SECURE_COOKIES=true
DJANGO_TIME_ZONE=__TZ__
HSG_DATA_DIR=/var/lib/homeschool-grades
HSG_STATIC_ROOT=/var/lib/homeschool-grades/static
